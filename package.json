  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@wxt-dev/auto-icons": "^1.1.2",
    "jsdom": "^30.1.2",
    "mockdate": "^3.0.5",
    "prettier": "3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "emoji-regex": "^11.0.0"
  },
  "engines": {
    "npm": ">=10.0.0",
    "node": "^22.22.2 || >=24.15.0"
  }
